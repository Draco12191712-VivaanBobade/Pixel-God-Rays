{
  "format_version": "1.26.10",
  "particle_effect": {
    "description": {
      "identifier": "godrays:canopy_shafts",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/godrays_shaft"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "per_update_expression": "v.tod = q.time_of_day > 0.0 ? q.time_of_day : (v.tod_start ?? 0.0); v.sun_angle = (v.tod - 0.25) * 360.0; v.sun_x = math.cos(v.sun_angle); v.sun_y = math.sin(v.sun_angle); v.night = v.sun_y < 0.0 ? 1.0 : 0.0; v.light_x = v.night ? -v.sun_x : v.sun_x; v.light_y = v.night ? -v.sun_y : v.sun_y; v.high = math.clamp((v.light_y - 0.2) * 1.6, 0.0, 1.0); v.wet = math.lerp(v.wet ?? 0.0, q.is_in_water_or_rain, 0.03); v.strength = math.clamp(v.light_y * 5.0, 0.0, 1.0) * (1.0 - 0.5 * v.high) * (1.0 - v.wet) * (v.night ? 0.35 * q.moon_brightness : 1.0);"
      },
      "minecraft:emitter_lifetime_expression": {
        "activation_expression": "v.strength > 0.02",
        "expiration_expression": 0
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "320.0 / math.max(1.0, q.effect_emitter_count)",
        "max_particles": 140
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0.0,
          6.0,
          0.0
        ],
        "half_dimensions": [
          24.0,
          14.0,
          24.0
        ],
        "surface_only": false
      },
      "minecraft:particle_initialization": {
        "per_update_expression": "v.c_len = 2.0 + 3.0 * v.particle_random_1; v.c_wide = v.particle_random_4 < 0.15 ? 0.25 + 0.35 * (v.particle_random_2 * 3.0 - math.floor(v.particle_random_2 * 3.0)) : 0.04 + 0.08 * v.particle_random_2; v.c_bright = 0.5 + 0.5 * v.particle_random_3;"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(10.0, 18.0)"
      },
      "minecraft:particle_expire_if_not_in_blocks": [
        "minecraft:acacia_leaves",
        "minecraft:azalea_leaves",
        "minecraft:azalea_leaves_flowered",
        "minecraft:birch_leaves",
        "minecraft:cherry_leaves",
        "minecraft:dark_oak_leaves",
        "minecraft:jungle_leaves",
        "minecraft:leaves",
        "minecraft:leaves2",
        "minecraft:mangrove_leaves",
        "minecraft:oak_leaves",
        "minecraft:orange_poplar_leaves",
        "minecraft:pale_oak_leaves",
        "minecraft:red_poplar_leaves",
        "minecraft:spruce_leaves",
        "minecraft:yellow_poplar_leaves"
      ],
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.c_len",
          "v.c_wide"
        ],
        "facing_camera_mode": "lookat_direction",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.light_x",
            "v.light_y",
            0.0
          ]
        },
        "uv": {
          "texture_width": 32,
          "texture_height": 4,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            4
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              "1.0 * (1.0 - v.night) + 0.62 * v.night",
              "0.74 + 0.18 * v.high * (1.0 - v.night) + 0.66 * v.night + 0.08 * ((v.particle_random_1 * 5.0 - math.floor(v.particle_random_1 * 5.0)) - 0.5)",
              "0.46 + 0.32 * v.high * (1.0 - v.night) + 1.0 * v.night - 0.08 * ((v.particle_random_1 * 5.0 - math.floor(v.particle_random_1 * 5.0)) - 0.5)",
              "v.strength * v.c_bright * 0.22 * math.sin(180.0 * math.clamp(v.particle_age / v.particle_lifetime, 0.0, 1.0))"
            ]
          },
          "interpolant": 0
        }
      }
    }
  }
}
