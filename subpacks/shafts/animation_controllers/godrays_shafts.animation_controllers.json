{
  "format_version": "1.21.130",
  "animation_controllers": {
    "controller.animation.godrays.sun_shafts": {
      "initial_state": "off",
      "states": {
        "off": {
          "transitions": [
            {
              "on": "!q.is_in_ui && q.distance_from_camera < 6.0 && !q.entity_biome_has_any_tags('nether', 'the_end')"
            }
          ]
        },
        "on": {
          "particle_effects": [
            {
              "effect": "godrays_sun_shafts",
              "pre_effect_script": "variable.tod_start = query.time_of_day;"
            },
            {
              "effect": "godrays_canopy_shafts",
              "pre_effect_script": "variable.tod_start = query.time_of_day;"
            }
          ],
          "transitions": [
            {
              "off": "!(!q.is_in_ui && q.distance_from_camera < 6.0 && !q.entity_biome_has_any_tags('nether', 'the_end'))"
            }
          ]
        }
      }
    }
  }
}
